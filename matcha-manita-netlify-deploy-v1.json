    "logoReferencedByIndex": true,
    "logoPresentInVerifiedRepository": false,
    "releaseGate": "BLOCKED_UNTIL_REQUIRED_ASSET_EXISTS"
  },

  "runtimeArchitecture": {
    "authentication": "SUPABASE_AUTH",
    "customerIdentitySource": "VERIFIED_SUPABASE_USER_ID",
    "anonymousCheckoutAllowed": false,
    "orderSessionEndpoint": "/.netlify/functions/create-order-session",
    "paymentIntentEndpoint": "/.netlify/functions/create-payment-intent",
    "bankingAuthority": "SonoraPort Banking",
    "directBrowserBanking": false,
    "serverSideBankingRequired": true,
    "orderOwnershipProofRequired": true,
    "idempotencyRequired": true,
    "failClosed": true
  },

  "environmentRequirements": {
    "serverOnly": [
      "MATCHA_MANITA_ORDER_OWNERSHIP_SECRET",
      "MATCHA_MANITA_BANKING_TOKEN"
    ],
    "requiredRuntimeConfiguration": [
      "MATCHA_MANITA_SUPABASE_URL",
      "MATCHA_MANITA_SUPABASE_PUBLISHABLE_KEY",
      "MATCHA_MANITA_ORDER_OWNERSHIP_SECRET",
      "SONORAPORT_BANKING_API_URL",
      "MATCHA_MANITA_BANKING_TOKEN"
    ],
    "secretValuesStoredInRegistry": false,
    "secretValuesAllowedInFrontend": false
  },

  "productionChecks": {
    "sourceRepository": "VERIFIED",
    "jsonContracts": "VERIFIED",
    "skuCatalogWiring": "VERIFIED",
    "orderSessionSource": "VERIFIED",
    "paymentIntentSource": "VERIFIED",
    "requiredArtworkAssets": "BLOCKED",
    "netlifyFunctionsDeployment": "PENDING",
    "supabaseAuthenticationRuntime": "PENDING",
    "unauthenticatedOrderSessionExpectedStatus": 401,
    "authenticatedOrderSessionRuntime": "PENDING",
    "ownershipProofRuntime": "PENDING",
    "paymentIntentRuntime": "PENDING",
    "sonoraportBankingBridgeRuntime": "PENDING",
    "endToEndCheckout": "PENDING"
  },

  "security": {
    "browserBankingSecrets": false,
    "browserOwnershipSecret": false,
    "browserServiceRoleCredentials": false,
    "browserSuppliedCustomerIdTrusted": false,
    "orderOwnership": "SERVER_GENERATED_HMAC",
    "settlementAuthority": "SONORAPORT_BANKING",
    "manufacturedSettlementSuccessAllowed": false,
    "failClosed": true
  },

  "releaseGate": {
    "sourceReady": true,
    "assetsReady": false,
    "runtimeVerified": false,
    "productionReady": false,
    "blockingReasons": [
      "REQUIRED_LOGO_ASSET_NOT_VERIFIED_IN_REPOSITORY",
      "NETLIFY_FUNCTIONS_DEPLOYMENT_NOT_VERIFIED",
      "AUTHENTICATED_RUNTIME_NOT_VERIFIED",
      "SONORAPORT_BANKING_RUNTIME_NOT_VERIFIED",
      "END_TO_END_CHECKOUT_NOT_VERIFIED"
    ]
  },

  "nextSwarm": {
    "target": "AUTH_REGISTRY_AND_VALIDATION_WORKFLOW",
    "deployAfterRequiredAssetsExist": true,
    "doNotClaimProductionReadyBeforeRuntimeVerification": true
  }
}
